-- 4. หมวดหมู่: Player (ผู้เล่น)
--------------------------------------------------------------------------------
local TabPlayer = Window:Tab({
    Title = "Player",
    Icon = "user",
})

local SecPlayer = TabPlayer:Section({ Title = "ตั้งค่าตัวละคร" })
SecPlayer:Toggle({
    Title = "เดินเร็วพิเศษ (WalkSpeed Hack)",
    Callback = function(state)
        if state then
            pcall(function() game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 50 end)
        else
            pcall(function() game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 16 end)
        end
    end
})

SecPlayer:Toggle({
    Title = "กระโดดสูงพิเศษ (JumpPower Hack)",
    Callback = function(state)
        if state then
            pcall(function() game.Players.LocalPlayer.Character.Humanoid.JumpPower = 120 end)
        else
            pcall(function() game.Players.LocalPlayer.Character.Humanoid.JumpPower = 50 end)
        end
    end
})

