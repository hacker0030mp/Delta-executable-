-- ตรรกะระบบจัดการ Script Editor และ Save/Load
local DeltaScriptHub = {
    Editor = {
        ScriptBuffer1 = "",
        ScriptBuffer2 = "",
        ScriptBuffer3 = "",
        
        SetScript1 = function(self, codeText) self.ScriptBuffer1 = codeText or "" end,
        SetScript2 = function(self, codeText) self.ScriptBuffer2 = codeText or "" end,
        SetScript3 = function(self, codeText) self.ScriptBuffer3 = codeText or "" end,
        
        RunScript = function(self, target)
            local code = (target == 1 and self.ScriptBuffer1) or (target == 2 and self.ScriptBuffer2) or self.ScriptBuffer3
            if code == "" then
                WindUI:Notify({ Title = "แจ้งเตือน", Content = "กรุณาใส่ Script ในช่องที่ " .. target, Duration = 2 })
                return
            end
            local func, err = loadstring(code)
            if not func then
                WindUI:Notify({ Title = "Syntax Error", Content = tostring(err), Duration = 3 })
                return
            end
            local success, runErr = pcall(func)
            if not success then
                WindUI:Notify({ Title = "Execution Error", Content = tostring(runErr), Duration = 3 })
            else
                WindUI:Notify({ Title = "สำเร็จ", Content = "รัน Script ช่องที่ " .. target .." เรียบร้อย", Duration = 2 })
            end
        end,

        SaveAllScripts = function(self)
            if writefile then
                local data = "--- [DELTA SCRIPT HUB SAVE DATA] ---\n" ..
                             "[SLOT1]-->>\n" .. self.ScriptBuffer1 .. "\n<<--[SLOT1]\n" ..
                             "[SLOT2]-->>\n" .. self.ScriptBuffer2 .. "\n<<--[SLOT2]\n" ..
                             "[SLOT3]-->>\n" .. self.ScriptBuffer3 .. "\n<<--[SLOT3]"
                pcall(function()
                    writefile("SurinYinYang_SaveSlot.txt", data)
                end)
                WindUI:Notify({ Title = "บันทึกสำเร็จ", Content = "บันทึกสคริปต์ทั้งหมดลงไฟล์เรียบร้อย", Duration = 3 })
            else
                WindUI:Notify({ Title = "ข้อผิดพลาด", Content = "ตัวรันไม่รองรับ writefile", Duration = 3 })
            end
        end,

        LoadSavedScripts = function(self)
            if readfile and isfile and isfile("SurinYinYang_SaveSlot.txt") then
                local success, content = pcall(function()
                    return readfile("SurinYinYang_SaveSlot.txt")
                end)
                if success and content then
                    local s1 = content:match("%[SLOT1%]%-%->>(.-)<<%-%[SLOT1%]")
                    local s2 = content:match("%[SLOT2%]%-%->>(.-)<<%-%[SLOT2%]")
                    local s3 = content:match("%[SLOT3%]%-%->>(.-)<<%-%[SLOT3%]")
                    
                    if s1 then self.ScriptBuffer1 = s1 end
                    if s2 then self.ScriptBuffer2 = s2 end
                    if s3 then self.ScriptBuffer3 = s3 end
                    
                    WindUI:Notify({ Title = "โหลดสำเร็จ", Content = "ดึงข้อมูลสคริปต์จากช่องบันทึกสำเร็จ", Duration = 3 })
                    return s1, s2, s3
                end
            else
                WindUI:Notify({ Title = "ไม่พบไฟล์", Content = "ยังไม่มีประวัติการบันทึกสคริปต์", Duration = 3 })
            end
            return nil, nil, nil
        end
    }
}

SecSaveSystem:Button({
    Title = "💾 บันทึกสคริปต์ปัจจุบัน",
