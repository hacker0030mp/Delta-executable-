-- =========================================================================
-- 💾 หมวดหมู่ที่ 1: บันทึกและรันสคริปต์ (Script Manager & Save Slots)
-- =========================================================================
local TabSave = Window:Tab({ Title = "บันทึกสคริปต์", Icon = "save" })
local SecSaveSystem = TabSave:Section({ Title = "จัดการและรันสคริปต์ (Editor & Save Slots)" })

local currentSlotName = "ScriptSlot_1"
local inputScriptCode = ""

SecSaveSystem:Input({
    Title = "ชื่อช่องบันทึก / Slot Name",
    Placeholder = "เช่น MyScript1...",
    Callback = function(text)
        if text and text ~= "" then currentSlotName = text end
    end
})

SecSaveSystem:Input({
    Title = "เนื้อหาสคริปต์ (Script Code)",
    Placeholder = "วางโค้ดสคริปต์ของคุณที่นี่...",
    Callback = function(text)
        inputScriptCode = text or ""
    end
})

SecSaveSystem:Button({
    Title = "🟢 รันสคริปต์ปัจจุบัน",
    Callback = function()
        if inputScriptCode == "" then
            WindUI:Notify({ Title = "⚠️ แจ้งเตือน", Content = "กรุณากรอกโค้ดสคริปต์ก่อนรัน", Duration = 2 })
            return
        end
        local func, err = loadstring(inputScriptCode)
        if not func then
            WindUI:Notify({ Title = "❌ Syntax Error", Content = tostring(err), Duration = 3 })
            return
        end
        local runSuccess, runErr = pcall(func)
        if runSuccess then
            WindUI:Notify({ Title = "✅ สำเร็จ", Content = "รันสคริปต์เรียบร้อยแล้ว", Duration = 2 })
        else
            WindUI:Notify({ Title = "❌ Execution Error", Content = tostring(runErr), Duration = 3 })
        end
    end
})

SecSaveSystem:Button({
    Title = "💾 บันทึกสคริปต์ลงเครื่อง",
    Callback = function()
        if writefile then
            local filename = currentSlotName .. ".txt"
            local ok, err = pcall(function() writefile(filename, inputScriptCode) end)
            if ok then
                WindUI:Notify({ Title = "💾 บันทึกสำเร็จ", Content = "บันทึกไฟล์: " .. filename, Duration = 3 })
            else
                WindUI:Notify({ Title = "❌ ผิดพลาด", Content = tostring(err), Duration = 3 })
            end
        else
            WindUI:Notify({ Title = "⚠️ ไม่รองรับ", Content = "ตัวรันไม่รองรับฟังก์ชัน writefile", Duration = 3 })
        end
    end
})

SecSaveSystem:Button({
    Title = "📂 โหลดสคริปต์ที่บันทึกไว้",
    Callback = function()
        if readfile and isfile then
            local filename = currentSlotName .. ".txt"
            if isfile(filename) then
                local ok, content = pcall(function() return readfile(filename) end)
                if ok and content then
                    inputScriptCode = content
                    WindUI:Notify({ Title = "📂 โหลดสำเร็จ", Content = "ดึงข้อมูลจากไฟล์ " .. filename .. " แล้ว", Duration = 3 })
                end
            else
                WindUI:Notify({ Title = "⚠️ ไม่พบไฟล์", Content = "ไม่พบไฟล์ชื่อ: " , Duration = 3 })
            end
        else
            WindUI:Notify({ Title = "⚠️ ไม่รองรับ", Content = "ตัวรันไม่รองรับฟังก์ชันอ่านไฟล์", Duration = 3 })
        end
    end
})

