-- 🌐 หมวดหมู่ใหม่: Browser Script (ดึงสคริปต์จากเว็บ/URL)
-- =========================================================================
local TabBrowser = Window:Tab({ Title = "Browser Script", Icon = "globe" })
local SecBrowser = TabBrowser:Section({ Title = "ดึงและรันสคริปต์ผ่านเว็บลิงก์ (URL Loader)" })

local browserUrlInput = ""

SecBrowser:Input({
    Title = "ใส่ URL / ลิงก์สคริปต์เว็บเบราว์เซอร์",
    Placeholder = "https://raw.githubusercontent.com/...",
    Callback = function(text)
        browserUrlInput = text or ""
    end
})

SecBrowser:Button({
    Title = "🌐 ดึงและรันสคริปต์จาก Browser URL",
    Callback = function()
        if browserUrlInput == "" then
            WindUI:Notify({ Title = "⚠️ แจ้งเตือน", Content = "กรุณากรอกลิงก์ URL ก่อนดึงข้อมูล", Duration = 2 })
            return
        end
        
        WindUI:Notify({ Title = "🌐 Browser Script", Content = "กำลังดึงข้อมูลจากเว็บ...", Duration = 3 })
        
        local getOk, scriptData = pcall(function()
            return game:HttpGet(browserUrlInput)
        end)

        if getOk and scriptData and scriptData ~= "" and not string.find(scriptData, "404") then
            local func, err = loadstring(scriptData)
            if func then
                local runOk, runErr = pcall(func)
                if runOk then
                    WindUI:Notify({ Title = "✅ สำเร็จ", Content = "รันสคริปต์จาก Browser URL เรียบร้อย", Duration = 3 })
                else
                    WindUI:Notify({ Title = "❌ Execution Error", Content = tostring(runErr), Duration = 4 })
                end
            else
                WindUI:Notify({ Title = "❌ Syntax Error", Content = tostring(err), Duration = 4 })
            end
        else
            WindUI:Notify({ Title = "❌ ไม่สามารถดึงไฟล์ได้", Content = "ลิงก์ไม่ถูกต้องหรือเกิดข้อผิดพลาด 404", Duration = 4 })
        end
    end
})

